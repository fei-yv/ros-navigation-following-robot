-//����ģʽ
+// JDY-31 BLE module AT command feedback filter
+static uint8_t ATCommandFeedBack_JDY31(uint8_t recv)
+{
+	uint8_t isFilter = 0;
+	static uint8_t lastrecv = 0;
+	static uint8_t filterIndex = 0;
+
+	const char* JDY31_Connect    = "OK+CONN\r\n";
+	const char* JDY31_DisConnect = "OK+LOST\r\n";
+	const char* JDY31_Startup    = "+START\r\n";
+	enum {
+		JDY31_NORMAL = 0,
+		JDY31_CONNECTSTART,
+		JDY31_DISCONNECTSTART,
+		JDY31_STARTUPSTART,
+	};
+	static uint8_t statemachine = JDY31_NORMAL;
+
+	switch (statemachine)
+	{
+	case JDY31_NORMAL:
+		if (recv == 'K' && lastrecv == 'O') {
+			statemachine = JDY31_CONNECTSTART;
+			isFilter = 1; filterIndex = 2;
+		} else if (recv == 'T' && lastrecv == 'S') {
+			statemachine = JDY31_STARTUPSTART;
+			isFilter = 1; filterIndex = 2;
+		}
+		break;
+	case JDY31_CONNECTSTART:
+		if (JDY31_Connect[filterIndex] == recv) {
+			isFilter = 1;
+		} else if (recv == 'L' && JDY31_Connect[filterIndex] == 'C') {
+			statemachine = JDY31_DISCONNECTSTART;
+			isFilter = 1; filterIndex = 2;
+		} else {
+			statemachine = JDY31_NORMAL;
+		}
+		filterIndex++;
+		if (filterIndex == strlen(JDY31_Connect))
+			statemachine = JDY31_NORMAL;
+		break;
+	case JDY31_DISCONNECTSTART:
+		if (JDY31_DisConnect[filterIndex] == recv)
+			isFilter = 1;
+		else
+			statemachine = JDY31_NORMAL;
+		filterIndex++;
+		if (filterIndex == strlen(JDY31_DisConnect))
+			statemachine = JDY31_NORMAL;
+		break;
+	case JDY31_STARTUPSTART:
+		if (JDY31_Startup[filterIndex] == recv)
+			isFilter = 1;
+		else
+			statemachine = JDY31_NORMAL;
+		filterIndex++;
+		if (filterIndex == strlen(JDY31_Startup))
+			statemachine = JDY31_NORMAL;
+		break;
+	}
+	lastrecv = recv;
+	return isFilter;
+}
+
