index 634c58b..c71d8da 100644
--- a/HARDWARE/usartx.c
+++ b/HARDWARE/usartx.c
@@ -845,6 +845,58 @@ static uint8_t ATCommandFeedBack_JDY33(uint8_t recv)
 }
 
 //调试模式
+static uint8_t ATCommandFeedBack_JDY31(uint8_t recv)
+{
+	uint8_t isFilter = 0;
+	static uint8_t filterIndex = 0;
+	static const char* messages[3] = {
+		"OK+CONN\r\n", "OK+LOST\r\n", "+START\r\n"
+	};
+	uint8_t i;
+	uint8_t matched;
+
+	if(filterIndex == 0)
+	{
+		for(i=0; i<3; i++)
+		{
+			if(recv == messages[i][0])
+			{
+				filterIndex = 1;
+				isFilter = 1;
+				break;
+			}
+		}
+		return isFilter;
+	}
+
+	matched = 0;
+	for(i=0; i<3; i++)
+	{
+		if(filterIndex < strlen(messages[i]) &&
+		   recv == messages[i][filterIndex])
+		{
+			matched = 1;
+			if(filterIndex + 1 >= strlen(messages[i]))
+				filterIndex = 0;
+			else
+				filterIndex++;
+			break;
+		}
+	}
+	if(matched)
+		return 1;
+
+	filterIndex = 0;
+	for(i=0; i<3; i++)
+	{
+		if(recv == messages[i][0])
+		{
+			filterIndex = 1;
+			return 1;
+		}
+	}
+	return 0;
+}
 void RobotControl_SetDebugLevel(char uart_recv)
 {
 	
@@ -889,6 +941,7 @@ int USART2_IRQHandler(void)
 		uint8_t ATFilter = 0;
 		ATFilter += ATCommandFeedBack_JDY33(Usart_Receive);
 		ATFilter += ATCommandFeedBack_BT04A(Usart_Receive);
+		ATFilter += ATCommandFeedBack_JDY31(Usart_Receive);
 		if( ATFilter > 0 ) return 0; //任意存在一个蓝牙的过滤信息,则过滤
 		
 		_System_Reset_(Usart_Receive);
